:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x556e760c6c70 .scope module, "and_ex_tb" "and_ex_tb" 2 4;
 .timescale -9 -9;
v0x556e760d81a0_0 .net "f", 0 0, L_0x556e760d8440;  1 drivers
v0x556e760d8270_0 .var "x1", 0 0;
v0x556e760d8340_0 .var "x2", 0 0;
S_0x556e760c6e00 .scope module, "a" "and_ex" 2 8, 3 1 0, S_0x556e760c6c70;
 .timescale -9 -9;
    .port_info 0 /INPUT 1 "x1";
    .port_info 1 /INPUT 1 "x2";
    .port_info 2 /OUTPUT 1 "f";
L_0x556e760d8440 .functor AND 1, v0x556e760d8270_0, v0x556e760d8340_0, C4<1>, C4<1>;
v0x556e7608fc00_0 .net "f", 0 0, L_0x556e760d8440;  alias, 1 drivers
v0x556e760d7fc0_0 .net "x1", 0 0, v0x556e760d8270_0;  1 drivers
v0x556e760d8080_0 .net "x2", 0 0, v0x556e760d8340_0;  1 drivers
    .scope S_0x556e760c6c70;
T_0 ;
    %vpi_call 2 11 "$dumpfile", "and_ex_tb.vcd" {0 0 0};
    %vpi_call 2 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x556e760c6c70 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x556e760d8270_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x556e760d8340_0, 0, 1;
    %delay 1, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x556e760d8270_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x556e760d8340_0, 0, 1;
    %delay 1, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x556e760d8270_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x556e760d8340_0, 0, 1;
    %delay 1, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x556e760d8270_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x556e760d8340_0, 0, 1;
    %delay 1, 0;
    %vpi_call 2 26 "$display", "test complete" {0 0 0};
    %end;
    .thread T_0;
